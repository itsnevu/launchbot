BOT_TOKEN=isi_token_dari_BotFather

# Batasi siapa yang boleh pakai bot (telegram user id, pisah koma). Kosong = semua orang.
ALLOWED_USER_IDS=

# --- pons v2 / Robinhood Chain (chainId 4663) ---
PONS_RPC_URLS=https://rpc.mainnet.chain.robinhood.com
PONS_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
PONS_ROUTER=0xe33E9E479dF8802cb0866d5d05258bEc4cF62948

# --- Argus / Arc (chainId 5042) ---
# Pisah koma; endpoint publik Arc sering rate-limit, pakai >1.
ARC_RPC_URLS=https://rpc.mainnet.arc.io,https://rpc.drpc.mainnet.arc.io,https://rpc.blockdaemon.mainnet.arc.io
ARGUS_PORTAL=0xB021Be536808f551b31789422Fd28a6c9c6e97Da
# Pool Uniswap v4 USDC/ARGUS untuk harga ARGUS (launch quote ARGUS): fee,tickSpacing,hook. Default = pool likuiditas terbesar.
ARGUS_PRICE_POOL=9850,99,0x0000000000000000000000000000000000000000

# Slippage dev buy (bps). 300 = 3%.
SLIPPAGE_BPS=300

# Opsional: pin DNS host RPC ke IP (bypass DNS hijack ISP, mis. blokir TrustPositif di Indonesia).
# Format: host=ip,host=ip  — cari IP asli via https://cloudflare-dns.com/dns-query?name=HOST&type=A
DNS_PINS=

# Sesi idle (private key masih di memori) dihapus otomatis setelah N menit. Default 10.
SESSION_TTL_MIN=10

# Riwayat launch (JSONL, tanpa key). /history di bot membacanya.
HISTORY_FILE=launches.jsonl

# Opsional: JWT Pinata (pinata.cloud → API Keys) supaya user bisa kirim FOTO sebagai logo → di-upload ke IPFS.
# Kosong = user harus kirim URL logo.
PINATA_JWT=
